{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(npm run verify:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)"
    ],
    "ask": ["Bash(git commit:*)"],
    "deny": ["Bash(git push:*)", "Bash(git * --no-verify*)", "Bash(git commit -n:*)"]
  }
}
